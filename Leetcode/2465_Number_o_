package main 

import (
	"sort"
)

func main() {
    nums := []int{4, 1, 4, 0, 3, 5}
    fmt.Println(distinctAverages(nums)) 
}

func distinctAverages(nums []int) int {
   
    sort.Ints(nums)
    
    
    averages := make(map[int]bool)
    
    left := 0
    right := len(nums) - 1
    
    
    for left < right {
       
        sum := nums[left] + nums[right]
        averages[sum] = true
        
        
        left++
        right--
    }
    
    
    return len(averages)
}