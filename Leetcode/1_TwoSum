package main

import "fmt"

func main() {
    testNums := []int{2, 7, 11, 15}
    target := 9
    result := twoSum(testNums, target)
    fmt.Println(result) 
}
func twoSum(nums []int, target int) []int {
   
    m := make(map[int]int)

    for i, num := range nums {
       
        complement := target - num

        
        if index, ok := m[complement]; ok {
            
            return []int{index, i}
        }

       
        m[num] = i
    }

    
    return nil
}